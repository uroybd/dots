
export PATH="$PATH:/opt/homebrew/bin:/Users/{{ HOME }}/.local/bin"
export SSH_AUTH_SOCK=/Users/meghnaad/.bitwarden-ssh-agent.sock
# Taskwarrior syncs with R2; task has no taskrc setting for the endpoint, so it must be in the environment.
export AWS_ENDPOINT_URL="{{ TW_BUCKET }}"

if [ -f '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc' ]; then . '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc'; fi
