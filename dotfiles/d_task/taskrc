include ./unix.rc
include ./theme.rc
include ./sync.rc

color=on

weekstart=Monday
dateformat.report=D b y H:N
dateformat.info=D b y H:N

# Custom fields
## Jira
uda.jira.type=string
uda.jira.label=Jira

## Reminder
uda.remind_in.type=string
uda.remind_in.label=Remind in

## Details
uda.details.type=string
uda.details.label=Details

## Outcome
uda.outcome.type=string
uda.outcome.label=Outcome
uda.outcome.values=success,failed

## TODO
uda.todo.type=string
uda.todo.label=TODO

## Progress
uda.progress.type=numeric
uda.progress.label=Progress
uda.progress.default=0


## Kanban
uda.progressState.type=string
uda.progressState.label=Progress
uda.progressState.values=inprogress,review

# Journaling
journal.time=on
journal.time.start.annotation="Start Session"
journal.time.stop.annotation="End Session"

# Reports
report.next.columns=id,jira,project,description,urgency,todo,progress,tags,due.countdown
report.next.labels=ID,Jira,Project,Description,Urgency,TODO,Progress,Tags,Due


# Report: Neovim
report.neovim.description=Tasks
report.neovim.columns=id,jira,urgency,due.countdown,project.indented,description
report.neovim.labels=ID,Jira,U,Due,Project,Description
report.neovim.sort=urgency-
report.neovim.filter=+PENDING -WAITING

# Report: Work
report.work.columns=id,jira,project.indented,description,urgency,todo,progress,tags,due.countdown
report.work.labels=ID,Jira,Project,Description,Urgency,TODO,Progress,Tags,Due
report.work.sort=status-/,urgency-
report.work.filter=project:FUL

# Report: WorkMini
report.workmini.columns=id,jira,project.indented,description
report.workmini.labels=ID,Jira,Project,Description
report.work.sort=status-/,urgency-
report.workmini.filter=project:FUL

# Report: Completed
report.completed.columns=id,uuid.short,entry,end,outcome,entry.age,depends,priority,project,tags,recur.indicator,due,description
report.completed.labels=ID,UUID,Created,Completed,Outcome,Age,Deps,P,Project,Tags,R,Due,Description
report.completed.sort=project+/,outcome+,end+

# Report: Kanban
report.kanban.description=Open tasks and the ones finished lately, for Kanban
report.kanban.columns=id,description,progress,todo,Urgency,project,jira,tags,due.relative,scheduled.countdown
report.kanban.labels=ID,Description,Progress,TODO,U,Project,Jira,Tags,Due,Sch
report.kanban.filter=( +PENDING or +COMPLETED )
report.kanban.sort=end-,urgency-


# Urgency
urgency.inherit=1
urgency.user.project.FUL.coefficient=1.5
urgency.user.project.J.coefficient=1.3
urgency.user.project.Meghnaad.coefficient=1.2
urgency.uda.progressState.review.coefficient=-3

# Review
uda.reviewed.type=date
uda.reviewed.label=Reviewed
report._reviewed.description=Tasksh review report.  Adjust the filter to your needs.
report._reviewed.columns=uuid
report._reviewed.sort=reviewed+,modified+
report._reviewed.filter=( reviewed.none: or reviewed.before:now-6days ) and ( +PENDING or +WAITING )


# Contexts
context.this_month.read=+MONTH or (end.after:som and end.before:eom) or (scheduled.after:som and scheduled.before:eom)
context.this_week.read=+WEEK or (end.after:sow and end.before:eow) or (scheduled.after:sow and scheduled.before:eow)

# Holidays
include holidays/nager-BD.rc
include holidays/en-US.rc
calendar.holidays=full
