color=on


weekstart=Monday

# Custom fields
# Jira
uda.jira.type=string
uda.jira.label=Jira

# Details
uda.details.type=string
uda.details.label=Details

# Outcome
uda.outcome.type=string
uda.outcome.label=Outcome
uda.outcome.values=success,failed

# Journaling
journal.time=on
journal.time.start.annotation="Start Session"
journal.time.stop.annotation="End Session"

# Reports
report.next.columns=id,jira,project,description,urgency,tags,due,priority
report.next.labels=ID,Jira,Project,Description,Urgency,Tags,Due,Priority


# Report: Neovim
report.neovim.description=Tasks
report.neovim.columns=id,jira,urgency,due.remaining,project.parent,description
report.neovim.labels=ID,Jira,U,Due,Project,Description
report.neovim.sort=urgency-
report.neovim.filter=+PENDING -WAITING limit:5


# Report: Completed
report.completed.columns=id,uuid.short,entry,end,outcome,entry.age,depends,priority,project,tags,recur.indicator,due,description
report.completed.labels=ID,UUID,Created,Completed,Outcome,Age,Deps,P,Project,Tags,R,Due,Description
report.completed.sort=project+/,outcome+,end+

# Urgency
urgency.inherit=1
urgency.user.project.FUL.coefficient=5.0

include ./unix.rc
include ./theme.rc
include ./sync.rc
