include ./unix.rc
include ./theme.rc
include ./sync.rc

color=on

weekstart=Monday

# Custom fields
# Jira
uda.jira.type=string
uda.jira.label=Jira

# Details
uda.details.type=string
uda.details.label=Details

# Outcome
uda.outcome.type=string
uda.outcome.label=Outcome
uda.outcome.values=success,failed

# TODO
uda.todo.type=string
uda.todo.label=TODO

# Journaling
journal.time=on
journal.time.start.annotation="Start Session"
journal.time.stop.annotation="End Session"

# Reports
report.next.columns=id,jira,project,description,todo,urgency,tags,due,priority
report.next.labels=ID,Jira,Project,Description,TODO,Urgency,Tags,Due,Priority


# Report: Neovim
report.neovim.description=Tasks
report.neovim.columns=id,jira,urgency,due.remaining,project.parent,description
report.neovim.labels=ID,Jira,U,Due,Project,Description
report.neovim.sort=urgency-
report.neovim.filter=+PENDING -WAITING limit:5


# Report: Completed
report.completed.columns=id,uuid.short,entry,end,outcome,entry.age,depends,priority,project,tags,recur.indicator,due,description
report.completed.labels=ID,UUID,Created,Completed,Outcome,Age,Deps,P,Project,Tags,R,Due,Description
report.completed.sort=project+/,outcome+,end+

# Urgency
urgency.inherit=1
urgency.user.project.FUL.coefficient=5.0

# Review
uda.reviewed.type=date
uda.reviewed.label=Reviewed
report._reviewed.description=Tasksh review report.  Adjust the filter to your needs.
report._reviewed.columns=uuid
report._reviewed.sort=reviewed+,modified+
report._reviewed.filter=( reviewed.none: or reviewed.before:now-6days ) and ( +PENDING or +WAITING )

color.project.FUL=bright blue
color.project.P=cyan
color.project.P.Intus=bright green
color.project.P.LTerm=bright magenta
rule.precedence.color=deleted,completed,active,keyword.,tag.,uda.outcome.failed,project.P.Intus,project.P.LTerm,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.
color.uda.priority.H=bold red
color.uda.priority.M=yellow
color.uda.priority.L=cyan
color.uda.outcome.success=green
color.uda.outcome.failed=red

# Contexts
context.this_month.read=+MONTH or (end.after:som and end.before:eom) or (scheduled.after:som and scheduled.before:eom)
context.this_week.read=+WEEK or (end.after:sow and end.before:eow) or (scheduled.after:sow and scheduled.before:eow)

# Holidays
include holidays/nager-BD.rc
calendar.holidays=full
