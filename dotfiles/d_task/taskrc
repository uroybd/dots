data.location=/Users/meghnaad/.task
news.version=3.5.0


hooks.location=~/.config/task/hooks
rc.hooks=on
rc.debug.hooks=2

color=on

# Custom fields
# Jira
uda.jira.type=string
uda.jira.label=Jira

# Details
uda.details.type=string
uda.details.label=Details

# Outcome
uda.outcome.type=string
uda.outcome.label=Outcome
uda.outcome.values=success,failed

# Journaling
journal.time=on
journal.time.start.annotaion="Start Session"
journal.time.stop.annotaion="End Session"

# Reports
report.next.columns=id,jira,project,description,urgency,tags,due,priority
report.next.labels=ID,Jira,Project,Description,Urgency,Tags,Due,Priority


# Report: Outcomes (completed tasks with pass/fail result)
report.outcomes.description=Completed tasks with their outcome
report.outcomes.columns=end,outcome,jira,project,description
report.outcomes.labels=Done,Outcome,Jira,Project,Description
report.outcomes.filter=status:completed
report.outcomes.sort=end+
color.uda.outcome.success=green
color.uda.outcome.failed=red

# Report: Neovim
report.neovim.description=Tasks
report.neovim.columns=id,jira,urgency,due.remaining,project.parent,description
report.neovim.labels=ID,Jira,U,Due,Project,Description
report.neovim.sort=urgency-
report.neovim.filter=+PENDING -WAITING limit:5

include ./sync.rc
