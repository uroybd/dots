# ====================================================================
# UNIVERSAL KANSŌ ADAPTIVE PALETTE (Zen / Ink / Mist / Pearl)
# ====================================================================
# Uses foreground-only rules so terminal themes dictate the hues.
# Leaves background fields empty to support true terminal transparency.

# General Task States
color.active=bold white
color.scheduled=yellow
color.until=bold yellow
color.due=bold red
color.due.today=bold red
color.overdue=bold red
color.recurring=blue

# Task Properties & Structural Organization
# (taskwarrior has no generic project/keyword rule, only color.project.<name> and
# color.keyword.<word>; color.tagged colors any task that has a tag)
color.tagged=green

# Urgency and Importance Scaling
color.blocked=magenta
color.blocking=bold magenta

# Visual Spacing & Breathing Room Adjustments
color.alternate=
color.calendar.due=red
color.calendar.due.today=bold red
color.calendar.overdue=bold red
color.calendar.scheduled=yellow
color.calendar.holiday=bold yellow
color.calendar.today=bold white
color.calendar.weekend=blue
color.calendar.weeknumber=cyan

# Report Header Styles
color.header=blue
color.footnote=blue
color.error=bold red
color.debug=blue
color.label=bold cyan
# The summary bar is drawn with spaces, so a plain foreground color is invisible; `inverse`
# swaps it onto the cell background, which keeps the rule foreground-only.
color.summary.bar=inverse cyan
color.summary.background=

# Command Interface Typography
color.history.add=green
color.history.delete=red
color.history.done=bright green
color.undo.before=red
color.undo.after=green
color.sync.added=green
color.sync.changed=yellow
color.sync.rejected=bold red

# Precedence & Merging Mechanics
rule.color.merge=yes
